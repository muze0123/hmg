{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HMG task completed event envelope",
  "type": "object",
  "required": [
    "id",
    "tenantId",
    "aggregateId",
    "type",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "hmg.task.completed.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "id",
        "version",
        "task"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "task": {
          "type": "object"
        }
      }
    }
  }
}
