{
  "name": "hmg",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "typecheck": "pnpm --dir frontend typecheck",
    "verify": "pnpm --dir frontend verify",
    "i18n:extract": "pnpm --dir frontend i18n:extract",
    "i18n:check": "pnpm --dir frontend i18n:check",
    "i18n:cjk": "pnpm --dir frontend i18n:cjk",
    "design:tokens": "pnpm --dir frontend design:tokens",
    "design:tokens:check": "pnpm --dir frontend design:tokens:check",
    "design:check": "pnpm --dir frontend design:check",
    "design:audit": "pnpm --dir frontend design:audit",
    "design:test": "pnpm --dir frontend design:test",
    "design:context": "pnpm --dir frontend design:context",
    "design:browser": "pnpm --dir frontend design:browser",
    "design:sync": "pnpm --dir frontend design:sync",
    "check": "pnpm --dir frontend check",
    "install:frontend": "pnpm --dir frontend install --frozen-lockfile",
    "backend:dev": "mvn -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=dev",
    "backend:test": "mvn -f backend/pom.xml test",
    "backend:build": "mvn -f backend/pom.xml package",
    "backend:start": "java -jar backend/target/hmg-backend-0.1.0.jar",
    "dev:connected": "pnpm --dir frontend dev --mode connected",
    "build:connected": "pnpm --dir frontend build --mode connected"
  }
}
